//// Decision 622 — Every function writes its return type, `-> void` included: `fn m(self: Self) -> void { … }`, `pub fn main() -> void { … }`; a `fn` with no `->` is refused at its name, `fn-return-missing`, `write -> void, or the type it answers`.

import {io.terminal} from "std";
import {of, Query} from "query";

type Order(city: string, total: i32)

type Ledger(orders: Order[]) {
    pub fn rows(self: Self) -> Query<Order> {
        return of(self.orders);
    }

    pub fn report(self: Self, city: string) -> void {
        terminal.print(city + "=" + self.totalOf(city).toString());
    }

    fn totalOf(self: Self, city: string) -> i32 {
        return self.rows().where({ o -> o.city == city }).sum({ o -> o.total });
    }
}

fn label(order: Order) -> string {
    return order.city + ":" + order.total.toString();
}

fn printAll(lines: string[]) -> void {
    for line in lines {
        terminal.print(line);
    }
}

pub fn main() -> void {
    val ledger = Ledger(orders: [
        Order(city: "Lyon", total: 10),
        Order(city: "Paris", total: 4),
        Order(city: "Lyon", total: 6),
    ]);
    ledger.report("Lyon");
    ledger.report("Nice");
    // The typed lambda writes its return type like any function.
    val big = fn(order: Order) -> bool {
        return order.total > 5;
    };
    printAll(ledger.rows().where(big).select(label).toArray());
}
