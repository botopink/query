//// Decision 330 — `?T` is read with TypeScript's operators and has no methods; `result` goes; a type declared in a type is its associated type.

import {io.terminal} from "std";
import {of, Query} from "query";

pub type Census {
    // `Entry` is declared in `Census`'s body, so it is `Census`'s associated type.
    pub type Entry(name: string, pop: i32, mayor: ?string)

    pub fn biggest(entries: Census.Entry[]) -> ?Census.Entry {
        return of(entries).orderByDescending({ e -> e.pop }).first();
    }
}

fn parseMin(text: string) -> Result<i32, string> {
    if (text == "") throw "no minimum";
    return text.length;
}

fn picker(present: bool) -> ?fn(q: Query<Census.Entry>) -> ?Census.Entry {
    return if (present)
        fn(q: Query<Census.Entry>) -> ?Census.Entry {
            return q.last();
        }
    else
        null;
}

pub fn main() -> void {
    val entries = [
        Census.Entry(name: "Lyon", pop: 5, mayor: "Doucet"),
        Census.Entry(name: "Paris", pop: 9, mayor: null),
        Census.Entry(name: "Nice", pop: 3, mayor: "Estrosi"),
    ];
    val top = Census.biggest(entries);
    terminal.print(top?.name ?? "nobody");
    // `?.` flattens: `mayor` is `?string`, so `top?.mayor` is `?string`, not `??string`.
    terminal.print(top?.mayor ?? "no mayor");
    terminal.print(Census.biggest([])?.name ?? "nobody");
    val sorted: ?Census.Entry[] = of(entries)
        .orderBy({ e -> e.name })
        .toArray();
    terminal.print(sorted?.[1]?.name ?? "none");
    terminal.print(picker(true)?.(of(entries))?.name ?? "none");
    terminal.print(picker(false)?.(of(entries))?.name ?? "no picker");
    terminal.print(top!.pop);
    terminal.print((of(entries).max({ e -> e.pop }) ?? 0) > 5 || top == null);
    // A `Result` is read with its own methods; there is no `result` namespace.
    val min = parseMin("ab");
    terminal.print(min.isOk());
    terminal.print(min.unwrapOr(0));
    terminal.print(parseMin("").isError());
}
