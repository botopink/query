//// Decision 696 — A template function is an annotation only when its signature declares the annotated declaration as its second parameter (578 (1): `syntax q: string`, then `syntax decl: unknown`); called as `` f @`…` `` it is `template-annotation-only`, and a template without that parameter at `#[f @`…`]` is `template-annotation-without-decl`.

import {io.terminal} from "std";
import {query} from "query";

type Order(city: string, total: i32)

val orders = [
    Order(city: "Lyon", total: 10),
    Order(city: "Paris", total: 4),
    Order(city: "Nice", total: 7),
];

// `query` takes one `syntax` parameter, the template text: it is called, never written as an annotation.
fn largeOrders() -> string[] {
    return query @`select city from orders where total > 5 order by city asc`;
}

pub fn main() -> void {
    terminal.print(largeOrders().join(","));
    terminal.print(query @`select count(*) from orders`);
}
