//// Decision 668 — A function's type parameter is always bound by a parameter, never by the return type alone.

import {io.terminal} from "std";
import {of} from "query";

type City(name: string, pop: i32)

// Refused at the declaration: `T` occurs only in the return type, so no argument fixes it.
fn nothing<T>() -> ?T {
    return null;
}

pub fn main() -> void {
    val cities = of([City(name: "Lyon", pop: 5)]);
    val missing: ?City = nothing();
    terminal.print((missing ?? cities.first())?.name ?? "none");
}
