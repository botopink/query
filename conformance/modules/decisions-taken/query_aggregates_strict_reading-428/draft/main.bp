//// Decision 428 — erika's aggregates keep the strict reading and gain only forms that mean something, with one answer in memory and on the database.

import {io.terminal} from "std";
import {query} from "query";

type Order(city: string, total: i32, coupon: ?string)

val orders = [
    Order(city: "Lyon", total: 10, coupon: "SPRING"),
    Order(city: "Paris", total: 4, coupon: null),
    Order(city: "Lyon", total: 6, coupon: null),
    Order(city: "Nice", total: 7, coupon: "WELCOME"),
];

val none: Order[] = [];

pub fn main() -> void {
    val n: i32 = query @`select count(*) from orders`;
    // `sum` over an `i32` field answers `i64`, `0` for no rows.
    val total: i64 = query @`select sum(total) from orders`;
    val empty: i64 = query @`select sum(total) from none`;
    // `avg` answers `?f64`, `null` for no rows; `min` and `max` answer `?F`.
    val mean: ?f64 = query @`select avg(total) from orders`;
    val noMean: ?f64 = query @`select avg(total) from none`;
    val #(low, high) = query @`select min(total), max(total) from orders`;
    // `count(f)` over a `?T` field counts the rows where it is not null.
    val withCoupon: i32 = query @`select count(coupon) from orders`;
    terminal.print(n);
    terminal.print(total);
    terminal.print(empty);
    terminal.print(mean ?? 0.0);
    terminal.print(noMean ?? -1.0);
    terminal.print((low ?? 0).toString() + ".." + (high ?? 0).toString());
    terminal.print(withCoupon);
    // With `group by`, the group field and aggregates only; `order by` names the group.
    val byCity = query @`select city, count(*), sum(total) from orders group by city order by city asc`;
    for (byCity) { row ->
        val #(city, count, sum) = row;
        terminal.print(city + " " + count.toString() + " " + sum.toString());
    }
}
